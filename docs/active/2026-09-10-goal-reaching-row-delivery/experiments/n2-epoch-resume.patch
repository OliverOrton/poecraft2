+void SolveWork::Impl::capture_goal_delivery_diagnostic() {
+    // Temporary bounded observation: no kernels, selection or scheduling changes.
+    if (options.carrier_ladder_exact_boundary_mode !=
+            CarrierLadderExactBoundaryMode::Record ||
+        !goal_delivery_diagnostic.empty() || transition_cache == nullptr) return;
+    const auto began = std::chrono::steady_clock::now();
+    const auto& limits = options.carrier_ladder_exact_boundary_limits;
+    constexpr std::uint64_t scratch = 1048576;
+    const auto live = fast_estimated_owned_bytes();
+    if (scratch > limits.max_owned_bytes || calc.state_count() > 20000 ||
+        (options.max_solver_owned_bytes != 0 &&
+         (live > options.max_solver_owned_bytes ||
+          scratch > options.max_solver_owned_bytes - live))) {
+        goal_delivery_diagnostic = "{\"status\":\"observation_cap\"}";
+        return;
+    }
+    const auto truth = [](bool b) { return b ? "true" : "false"; };
+    const auto format_double = [](double value) {
+        std::ostringstream out;
+        out << std::setprecision(17) << value;
+        return out.str();
+    };
+    const auto state_json = [&](std::uint32_t id) {
+        const auto& s = calc.state(id);
+        std::string j = "{\"id\":" + std::to_string(id) +
+            ",\"hash\":" + std::to_string(abstract_state_hash(s)) +
+            ",\"goal_mask\":" + std::to_string(satisfied_goal_mask_for_state(id)) +
+            ",\"terminal\":" + truth(calc.is_goal_state(s)) +
+            ",\"rarity\":" + std::to_string(s.rarity) +
+            ",\"prefixes\":" + std::to_string(s.prefix_count) +
+            ",\"suffixes\":" + std::to_string(s.suffix_count) +
+            ",\"flags\":" + std::to_string(s.flags) +
+            ",\"fractured_goals\":" + std::to_string(s.fractured_goal_mask) +
+            ",\"crafted_goals\":" + std::to_string(s.crafted_goal_mask) +
+            ",\"blocked\":" + std::to_string(s.blocked_mask) +
+            ",\"retry_basin\":" + std::to_string(s.goal_progress_retry_basin) +
+            ",\"expanded\":" + truth(id < expanded.size() && expanded[id]) +
+            ",\"slot_status\":[";
+        for (std::size_t i = 0; i < calc.layout().slots.size(); ++i) {
+            if (i) j += ',';
+            j += std::to_string(s.slot_status[i]);
+        }
+        j += "],\"junk\":[";
+        bool first = true;
+        for (std::size_t i = 0; i < s.junk_counts.size(); ++i) {
+            if (!s.junk_counts[i]) continue;
+            if (!first) j += ',';
+            first = false;
+            j += '[' + std::to_string(i) + ',' + std::to_string(s.junk_counts[i]) + ']';
+        }
+        return j + "]}";
+    };
+    using Debt = std::tuple<unsigned, unsigned, unsigned, unsigned>;
+    const auto debt = [&](std::uint32_t id) {
+        const auto& s = calc.state(id);
+        const unsigned goals = std::popcount(satisfied_goal_mask_for_state(id));
+        return Debt{goals, s.prefix_count + s.suffix_count - goals,
+                    s.rarity, s.goal_progress_retry_basin};
+    };
+    const auto debt_json = [](const Debt& d) {
+        const auto [g, j, r, b] = d;
+        return "{\"satisfied\":" + std::to_string(g) +
+            ",\"extra_affixes\":" + std::to_string(j) +
+            ",\"rarity\":" + std::to_string(r) +
+            ",\"retry_basin\":" + std::to_string(b);
+    };
+    std::map<Debt, std::uint32_t> population;
+    std::vector<std::uint32_t> samples{result.start_state};
+    const auto sample = [&](std::uint32_t id) {
+        if (id != kNoId && samples.size() < 10 &&
+            std::find(samples.begin(), samples.end(), id) == samples.end())
+            samples.push_back(id);
+    };
+    std::uint32_t best_full = kNoId;
+    for (std::uint32_t s = 0; s < calc.state_count(); ++s) {
+        ++population[debt(s)];
+        if (std::popcount(satisfied_goal_mask_for_state(s)) >=
+                calc.goal().required_satisfied_slots() &&
+            (best_full == kNoId || std::get<1>(debt(s)) <
+                std::get<1>(debt(best_full)))) best_full = s;
+    }
+    sample(best_full);
+    std::string json = "{\"schema\":\"goal_delivery_observation_v1\",\"status\":\"complete\",\"graph_identity\":" +
+        std::to_string(graph_identity()) + ",\"states\":" + std::to_string(calc.state_count()) +
+        ",\"rows\":" + std::to_string(transition_cache->rows.size()) +
+        ",\"expanded\":" + std::to_string(expanded_count) +
+        ",\"live_owned_bytes\":" + std::to_string(live) +
+        ",\"scheduler\":{\"incumbent\":" + truth(output_incumbent.has_value()) +
+        ",\"carriers\":" + std::to_string(incremental_carriers.size()) +
+        ",\"alternatives\":" + std::to_string(incremental_alternative_rows.size()) +
+        ",\"refinement_active\":" + truth(incremental_refinement_active) +
+        ",\"refinement_target\":" + std::to_string(incremental_refinement_target_expanded) +
+        ",\"queue\":" + std::to_string(queue.size()) +
+        ",\"expansion_active\":" + truth(expansion_active) +
+        ",\"restricted_values_ready\":" + truth(incremental_restricted_values_ready) +
+        ",\"envelope_closed\":" + truth(incremental_envelope_closed) +
+        ",\"finish_requested\":" + truth(requested_bounded_finish) +
+        ",\"cap_hit\":" + truth(result.diagnostics.resource_cap_hit) +
+        ",\"cooperative_high_progress\":" + truth(cooperative_high_progress_ordering_enabled()) +
+        "},\"population\":[";
+    bool first = true;
+    for (const auto& [d, count] : population) {
+        if (!first) json += ',';
+        first = false;
+        json += debt_json(d) + ",\"count\":" + std::to_string(count) + '}';
+    }
+    json += "],\"root_rows\":[";
+    first = true;
+    for (const auto r : state_row_indices(*transition_cache, result.start_state)) {
+        const auto& row = transition_cache->rows.at(r);
+        if (r >= priced_rows.size()) continue;
+        const auto op = priced_rows[r].operator_index;
+        if (op >= calc.operators().size()) continue;
+        std::map<Debt, std::pair<std::uint32_t, double>> outcomes;
+        std::uint32_t best = kNoId, missing = 0;
+        double terminal_mass = 0;
+        for (std::uint32_t i = 0; i < row.transition_count; ++i) {
+            const auto offset = row.transition_offset + i;
+            const auto t = transition_cache->successors.at(offset);
+            const auto p = transition_cache->probabilities.at(offset);
+            if (!(p > 0)) continue;
+            auto& out = outcomes[debt(t)]; ++out.first; out.second += p;
+            if (calc.is_goal_state(calc.state(t))) terminal_mass += p;
+            else if (t >= transition_cache->state_rows.size() ||
+                transition_cache->state_rows[t].count == 0) ++missing;
+            if (best == kNoId || std::get<0>(debt(t)) > std::get<0>(debt(best)) ||
+                (std::get<0>(debt(t)) == std::get<0>(debt(best)) &&
+                 std::get<1>(debt(t)) < std::get<1>(debt(best)))) best = t;
+        }
+        sample(best);
+        if (!first) json += ',';
+        first = false;
+        json += "{\"row\":" + std::to_string(r) + ",\"action\":";
+        append_json_string(json, calc.operators()[op].id);
+        json += ",\"admitted\":" + std::string(truth(row.admitted)) +
+            ",\"direct_missing\":" + std::to_string(missing) +
+            ",\"choices\":" + std::to_string(row.choice_count) +
+            ",\"terminal_mass\":" + format_double(terminal_mass) +
+            ",\"best_successor\":" + (best == kNoId ? "null" : std::to_string(best)) +
+            ",\"outcomes\":[";
+        bool first_debt = true;
+        for (const auto& [d, out] : outcomes) {
+            if (!first_debt) json += ',';
+            first_debt = false;
+            json += debt_json(d) + ",\"routes\":" + std::to_string(out.first) +
+                ",\"mass\":" + format_double(out.second) + '}';
+        }
+        json += "]}";
+    }
+    json += "],\"samples\":[";
+    first = true;
+    for (const auto s : samples) {
+        if (!first) json += ',';
+        first = false;
+        json += "{\"source\":" + state_json(s) + ",\"operators\":[";
+        bool first_op = true;
+        for (std::uint32_t op = 0; op < calc.operators().size(); ++op) {
+            const auto& planner = calc.operators()[op];
+            if (planner.kind != PlannerOperatorKind::Primitive) continue;
+            const bool requested = std::find(static_operator_indices.begin(), static_operator_indices.end(), op) != static_operator_indices.end() ||
+                std::find(delayed_operator_indices.begin(), delayed_operator_indices.end(), op) != delayed_operator_indices.end();
+            if (!requested) continue;
+            if (!first_op) json += ',';
+            first_op = false;
+            const auto* entry = action_envelope_ledger.find(s, op);
+            json += "{\"index\":" + std::to_string(op) + ",\"id\":";
+            append_json_string(json, planner.id);
+            json += ",\"legal\":" + std::string(truth(action_legal(session,
+                calc.registry().actions.at(planner.primitive_action), calc.state(s)))) +
+                ",\"lifecycle\":" + (entry ? std::to_string(static_cast<int>(entry->lifecycle)) : "null") +
+                ",\"lane\":" + (entry ? std::to_string(static_cast<int>(entry->lane)) : "null") +
+                ",\"reason\":";
+            append_json_string(json, entry ? entry->detail : "no_entry");
+            json += '}';
+        }
+        json += "]}";
+    }
+    json += "]}";
+    goal_delivery_diagnostic = std::move(json);
+    carrier_ladder_exact_boundary_private_wall_ns +=
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - began).count();
+}
