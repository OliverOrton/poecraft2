+                 std::get<1>(debt(t)) < std::get<1>(debt(best)))) best = t;
+        }
+        sample(best);
+        if (!first) json += ',';
+        first = false;
+        json += "{\"row\":" + std::to_string(r) + ",\"action\":";
+        append_json_string(json, calc.operators()[op].id);
+        json += ",\"admitted\":" + std::string(truth(row.admitted)) +
+            ",\"direct_missing\":" + std::to_string(missing) +
+            ",\"choices\":" + std::to_string(row.choice_count) +
+            ",\"terminal_mass\":" + format_double(terminal_mass) +
+            ",\"best_successor\":" + (best == kNoId ? "null" : std::to_string(best)) +
+            ",\"outcomes\":[";
