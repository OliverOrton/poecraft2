+    };
+    std::uint32_t best_full = kNoId;
+    for (std::uint32_t s = 0; s < calc.state_count(); ++s) {
+        ++population[debt(s)];
+        if (std::popcount(satisfied_goal_mask_for_state(s)) >=
+                calc.goal().required_satisfied_slots() &&
