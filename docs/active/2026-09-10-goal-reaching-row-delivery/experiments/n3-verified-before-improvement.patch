+        std::ostringstream out;
+        out << std::setprecision(17) << value;
+        return out.str();
+    };
+    const auto state_json = [&](std::uint32_t id) {
+        const auto& s = calc.state(id);
+        std::string j = "{\"id\":" + std::to_string(id) +
+            ",\"hash\":" + std::to_string(abstract_state_hash(s)) +
+            ",\"goal_mask\":" + std::to_string(satisfied_goal_mask_for_state(id)) +
+            ",\"terminal\":" + truth(calc.is_goal_state(s)) +
+            ",\"rarity\":" + std::to_string(s.rarity) +
+            ",\"prefixes\":" + std::to_string(s.prefix_count) +
+            ",\"suffixes\":" + std::to_string(s.suffix_count) +
+            ",\"flags\":" + std::to_string(s.flags) +
+            ",\"fractured_goals\":" + std::to_string(s.fractured_goal_mask) +
+            ",\"crafted_goals\":" + std::to_string(s.crafted_goal_mask) +
+            ",\"blocked\":" + std::to_string(s.blocked_mask) +
+            ",\"retry_basin\":" + std::to_string(s.goal_progress_retry_basin) +
+            ",\"expanded\":" + truth(id < expanded.size() && expanded[id]) +
+            ",\"slot_status\":[";
+        for (std::size_t i = 0; i < calc.layout().slots.size(); ++i) {
+            if (i) j += ',';
+            j += std::to_string(s.slot_status[i]);
+        }
+        j += "],\"junk\":[";
+        bool first = true;
+        for (std::size_t i = 0; i < s.junk_counts.size(); ++i) {
+            if (!s.junk_counts[i]) continue;
+            if (!first) j += ',';
+            first = false;
+            j += '[' + std::to_string(i) + ',' + std::to_string(s.junk_counts[i]) + ']';
+        }
+        return j + "]}";
+    };
+    using Debt = std::tuple<unsigned, unsigned, unsigned, unsigned>;
+    const auto debt = [&](std::uint32_t id) {
+        const auto& s = calc.state(id);
+        const unsigned goals = std::popcount(satisfied_goal_mask_for_state(id));
+        return Debt{goals, s.prefix_count + s.suffix_count - goals,
+                    s.rarity, s.goal_progress_retry_basin};
+    };
+    const auto debt_json = [](const Debt& d) {
+        const auto [g, j, r, b] = d;
+        return "{\"satisfied\":" + std::to_string(g) +
+            ",\"extra_affixes\":" + std::to_string(j) +
+            ",\"rarity\":" + std::to_string(r) +
+            ",\"retry_basin\":" + std::to_string(b);
+    };
+    std::map<Debt, std::uint32_t> population;
+    std::vector<std::uint32_t> samples{result.start_state};
+    const auto sample = [&](std::uint32_t id) {
+        if (id != kNoId && samples.size() < 10 &&
