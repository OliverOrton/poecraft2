+        }
+    }
+    std::vector<std::uint32_t> ranked;
+    for (std::uint32_t state = 0;
+         state < state_count; ++state) {
+        if (priority[state] > 0.0) ranked.push_back(state);
+    }
+    std::stable_sort(
+        ranked.begin(), ranked.end(),
+        [&](const std::uint32_t left,
+            const std::uint32_t right) {
