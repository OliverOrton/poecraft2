+            session->metamod_type[mod] = session->gen_type[mod] == PC_SIDE_SUFFIX ? 3 : 4;
+            session->special_kind[mod] = -1;
+            session->flags[mod] = 1 << 1;
+        }
+        session->bench_mod_ids = {8, 9};
+        auto registry = build_action_registry(*session);
