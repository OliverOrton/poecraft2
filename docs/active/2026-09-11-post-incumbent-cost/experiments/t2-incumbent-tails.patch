@@ -329,6 +329,55 @@ void run_resumable_joint_policy_continuation_fixture_tests() {
     evaluator_refused.release(Refusal::ExactEvaluatorRefused);
     PC_CHECK(compiler_refused.lifecycle == Lifecycle::Refused);
     PC_CHECK(evaluator_refused.lifecycle == Lifecycle::Refused);
+
+    /* A dense reforge prefix shares pending outcomes. Queue each semantic
+     * state once: duplicate waiting nodes must not exhaust candidate memory
+     * or its work cap before the positive-mass cleanup tail is serviced. */
+    constexpr std::uint32_t shared_tail = 65;
+    bool shared_tail_ready = false;
+    const auto resolve_shared = [&](const Node& source) {
+        Resolved result;
+        result.source = source;
+        if (source.locator == shared_tail + 1) {
+            result.kind = Resolved::Kind::Goal;
+        } else if (source.locator == shared_tail && !shared_tail_ready) {
+            result.kind = Resolved::Kind::Missing;
+        } else {
+            result.kind = Resolved::Kind::Row;
+            result.row_locator = source.locator;
+            result.row_semantic_key = row_key(source.locator);
+            result.action_semantic_key = action_key(source.locator);
+            if (source.locator < shared_tail) {
+                for (std::uint32_t next = source.locator + 1;
+                     next <= shared_tail; ++next) {
+                    result.successors.push_back(node(next));
+                }
+                // An observation may select an already queued direct outcome.
+                result.observed_choices.push_back({0, node(shared_tail)});
+            } else {
+                result.successors.push_back(node(shared_tail + 1));
+            }
+        }
+        return result;
+    };
+    const auto validate_shared = [&](const Decision& decision) {
+        return decision.row_semantic_key == row_key(decision.source.locator)
+            ? Refusal::None : Refusal::StructuralPrefixInvalid;
+    };
+    Candidate shared = Candidate::capture(snapshot, node(0), {}, {}, {},
+        30.0, 21, shared_tail + 2);
+    shared.advance(resolve_shared, validate_shared, shared_tail + 2);
+    PC_CHECK(shared.lifecycle == Lifecycle::WaitingForExactContinuation);
+    PC_CHECK(shared.missing == node(shared_tail));
+    PC_CHECK(shared.walk_state_count() == shared_tail + 1);
+    PC_CHECK(shared.fixed_decision_count() == shared_tail);
+    shared_tail_ready = true;
+    PC_CHECK(shared.mark_resumable(node(shared_tail)));
+    shared.advance(resolve_shared, validate_shared, 2);
+    PC_CHECK(shared.lifecycle == Lifecycle::CompleteCandidate);
+    PC_CHECK(shared.walk_state_count() == shared_tail + 2);
+    PC_CHECK(shared.fixed_decision_count() == shared_tail + 1);
+    PC_CHECK(shared.retained_work == shared_tail + 3);
 }
 
