+void SolveWork::Impl::trace_post_incumbent_diagnostic(const char* stage) {
+    // Temporary bounded observation of existing evidence; no row or value mutation.
+    const auto pass = incremental_upper_policy_passes_requested;
+    if (!output_incumbent || transition_cache == nullptr || pass == 0 ||
+        pass > 16 || (pass & (pass - 1)) != 0 || calc.state_count() > 50000)
+        return;
+    const auto numeric = [](double value) {
+        if (!std::isfinite(value) || value >= kValueCeiling) return std::string("null");
+        char text[64]; std::snprintf(text, sizeof(text), "%.17g", value);
+        return std::string(text);
+    };
+    const auto quoted = [](const std::string& text) {
+        std::string json; append_json_string(json, text); return json;
+    };
+    const auto semantic = [&](std::uint32_t state) {
+        std::string json = "[";
+        for (auto value : exact_abstract_state_key(calc.state(state), 0)) {
+            if (json.size() > 1) json += ',';
+            json += quoted(std::to_string(value));
+        }
+        return json + ']';
+    };
+    const auto& incumbent = *output_incumbent;
+    std::vector<double> boundary = incumbent.values;
+    boundary.resize(calc.state_count(), kInfinity);
+    const auto covered = [&](std::uint32_t state) {
+        return calc.is_goal_state(calc.state(state)) ||
+            (state < incumbent.policy_reachable.size() &&
+             incumbent.policy_reachable[state]);
+    };
+    for (std::uint32_t state = 0; state < boundary.size(); ++state) {
+        if (calc.is_goal_state(calc.state(state))) boundary[state] = 0.0;
+        else if (!covered(state)) boundary[state] = kInfinity;
+    }
+    std::vector<std::uint32_t> sources{result.start_state};
+    std::set<std::pair<std::uint32_t, std::uint32_t>> selected_shapes;
+    for (std::uint32_t state = 0; state < incumbent.policy_rows.size() &&
+         sources.size() < 6; ++state) {
+        if (state >= calc.state_count() || !covered(state) ||
+            calc.is_goal_state(calc.state(state))) continue;
+        auto row = incumbent.policy_rows[state];
+        if (row >= priced_rows.size()) continue;
+        if (selected_shapes.emplace(satisfied_goal_mask_for_state(state),
+                priced_rows[row].operator_index).second && state != result.start_state)
+            sources.push_back(state);
+    }
+    std::string json = "{\"post_incumbent_probe\":" + quoted(stage) +
+        ",\"pass\":" + std::to_string(pass) +
+        ",\"graph_identity\":" + quoted(std::to_string(graph_identity())) +
+        ",\"graph_rows\":" + std::to_string(transition_cache->rows.size()) +
+        ",\"expanded\":" + std::to_string(expanded_count) +
+        ",\"incumbent_cost\":" + numeric(incumbent.certified_upper_bound) +
+        ",\"incumbent_independent\":" + (incumbent.independently_evaluated ? "true" : "false") +
+        ",\"missing_requests\":" + std::to_string(incremental_anytime_missing_frontier_states.size()) +
+        ",\"sources\":[";
+    bool first_source = true;
+    for (auto state : sources) {
+        if (!first_source) json += ','; first_source = false;
+        const auto& item = calc.state(state);
+        const auto selected = state < incumbent.policy_rows.size()
+            ? incumbent.policy_rows[state] : std::numeric_limits<std::uint64_t>::max();
+        const auto seed = select_joint_policy_seed_row(state, result.values);
+        json += "{\"state\":" + std::to_string(state) + ",\"semantic_key\":" + semantic(state) +
+            ",\"goal_mask\":" + std::to_string(satisfied_goal_mask_for_state(state)) +
+            ",\"prefixes\":" + std::to_string(item.prefix_count) +
+            ",\"suffixes\":" + std::to_string(item.suffix_count) +
+            ",\"selected_row\":" + quoted(std::to_string(selected)) +
+            ",\"joint_seed_row\":" + quoted(std::to_string(seed)) +
+            ",\"incumbent_source_value\":" + numeric(boundary[state]) + ",\"rows\":[";
+        bool first_row = true; unsigned count = 0;
+        for (auto row_id : state_row_indices(*transition_cache, state)) {
+            if (++count > 32) break;
+            const auto& row = transition_cache->rows[row_id];
+            const auto& priced = priced_rows[row_id];
+            if (priced.operator_index >= calc.operators().size()) continue;
+            double unknown_mass = 0.0, missing_mass = 0.0, goal_mass = 0.0;
+            std::uint32_t unknown = 0, missing = 0;
+            std::string examples = "[";
+            for (std::uint32_t i = 0; i < row.transition_count; ++i) {
+                const auto at = row.transition_offset + i;
+                const auto next = transition_cache->successors[at];
+                const auto p = transition_cache->probabilities[at];
+                if (!(p > 0.0)) continue;
+                if (calc.is_goal_state(calc.state(next))) goal_mass += p;
+                if (next == state || covered(next)) continue;
+                ++unknown; unknown_mass += p;
+                if (next >= transition_cache->state_rows.size() ||
+                    transition_cache->state_rows[next].count == 0) {
+                    ++missing; missing_mass += p;
+                    if (missing <= 2) {
+                        if (examples.size() > 1) examples += ',';
+                        examples += "{\"state\":" + std::to_string(next) +
+                            ",\"semantic_key\":" + semantic(next) + '}';
+                    }
+                }
+            }
+            examples += ']';
+            const auto* entry = action_envelope_ledger.find(state, priced.operator_index);
+            if (!first_row) json += ','; first_row = false;
+            json += "{\"row\":" + std::to_string(row_id) +
+                ",\"action\":" + quoted(calc.operators()[priced.operator_index].id) +
+                ",\"immediate_cost\":" + numeric(priced.cost) +
+                ",\"admitted\":" + (row.admitted ? "true" : "false") +
+                ",\"masked_incumbent_q\":" + numeric(sparse_row_q_for_values(row_id, boundary)) +
+                ",\"direct_count\":" + std::to_string(row.transition_count) +
+                ",\"choice_groups\":" + std::to_string(row.choice_count) +
+                ",\"direct_goal_mass\":" + numeric(goal_mass) +
+                ",\"direct_outside_domain\":" + std::to_string(unknown) +
+                ",\"direct_outside_mass\":" + numeric(unknown_mass) +
+                ",\"direct_no_row\":" + std::to_string(missing) +
+                ",\"direct_no_row_mass\":" + numeric(missing_mass) +
+                ",\"missing_examples\":" + examples +
+                ",\"ledger_state\":" + std::to_string(entry ? static_cast<int>(entry->lifecycle) : -1) +
+                ",\"ledger_detail\":" + quoted(entry ? entry->detail : "absent") + '}';
+        }
+        json += "]}";
+    }
+    json += "]}";
+    std::fprintf(stderr, "%s\n", json.c_str());
+}
