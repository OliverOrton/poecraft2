+                priced_rows[row].operator_index == selected.policy[state].index &&
+                priced_rows[row].cost == selected.policy_row_costs[state]) {
+                return row;
+            }
+        }
+    }
     const bool first_policy = options.high_impact_executable_uppers &&
         incremental_action_generation && !output_incumbent.has_value();
     const auto goal_probability = [&](const std::uint64_t row_index) {
@@ -4590,6 +4612,12 @@ bool SolveWork::Impl::try_install_reachable_incumbent(
