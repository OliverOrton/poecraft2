+    if (options.high_impact_executable_uppers && output_incumbent &&
+        unverified_selected_policy_candidate) {
+        // Preserve a captured setup prefix when proposing a joint policy.
+        // Progress-per-attempt alone can replace a goal-neutral setup by a
+        // costly redraw. This is a row preference, never a boundary value:
+        // the joint walk still closes every positive exit, evaluates its own
