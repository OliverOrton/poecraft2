+                    bool safe = true, progress = false;
+                    for (std::uint32_t i = 0; i < row.transition_count; ++i) {
+                        if (!visit()) return out;
+                        const auto offset = row.transition_offset + i;
+                        if (!(graph.probabilities.at(offset) > 0)) continue;
+                        const auto t = graph.successors.at(offset);
+                        if (t >= out.winning.size() || !out.winning[t]) {
+                            safe = false;
+                            break;
