+void SolveWork::Impl::capture_completed_policy_support_diagnostic() {
+    // One immutable observation at the first publication boundary. No kernels,
+    // selected decisions, work queues or proof classifications are changed.
+    if (options.carrier_ladder_exact_boundary_mode !=
+            CarrierLadderExactBoundaryMode::Record ||
+        transition_cache == nullptr ||
+        completed_policy_support_observations >= 2 ||
+        completed_policy_support_row_generation == transition_cache->rows.size()) return;
+    const auto started = std::chrono::steady_clock::now();
+    const auto& limits = options.carrier_ladder_exact_boundary_limits;
+    const std::size_t n = calc.state_count();
+    const std::uint64_t scratch = n * 14ull +
+        transition_cache->rows.size() +
+        transition_cache->choices.size() * sizeof(std::uint32_t) + 262144;
+    const auto live = fast_estimated_owned_bytes();
+    if (scratch > limits.max_owned_bytes ||
+        (options.max_solver_owned_bytes != 0 &&
+         (live > options.max_solver_owned_bytes ||
+          scratch > options.max_solver_owned_bytes - live))) {
+        if (completed_policy_support_diagnostic.empty())
+            completed_policy_support_diagnostic =
+                "[{\"status\":\"unresolved_scratch_cap\"}]";
+        return;
+    }
+    std::vector<std::uint8_t> completed(transition_cache->rows.size(), 0);
+    for (std::size_t r = 0; r < completed.size(); ++r)
+        completed[r] = transition_cache->rows[r].admitted;
+    for (const auto& alternative : incremental_alternative_rows)
+        if (alternative.row_index < completed.size())
+            completed[alternative.row_index] = 1;
+    std::vector<std::uint8_t> terminals(n, 0);
+    for (std::uint32_t s = 0; s < n; ++s)
+        terminals[s] = calc.is_goal_state(calc.state(s));
+    // This initial diagnostic deliberately uses true goals only. An available
+    // incumbent is identified separately; its entry certificates need their
+    // existing compatibility/commitment checks before widening this view.
+    const auto support = construct_sparse_proper_policy_support(
+        *transition_cache, priced_rows, completed, terminals,
+        limits.max_exact_work);
+    std::string json = "{\"schema\":\"completed_policy_support_v1\",\"status\":";
+    append_json_string(json, support.complete ? "complete" : "unresolved_work_cap");
+    json += ",\"authority\":\"candidate_view_only\",\"graph_identity\":" +
+        std::to_string(graph_identity()) + ",\"states\":" + std::to_string(n) +
+        ",\"rows\":" + std::to_string(completed.size()) +
+        ",\"completed_rows\":" + std::to_string(std::count(completed.begin(), completed.end(), 1)) +
+        ",\"goals\":" + std::to_string(std::count(terminals.begin(), terminals.end(), 1)) +
+        ",\"winning_states\":" + std::to_string(std::count(support.winning.begin(), support.winning.end(), 1)) +
+        ",\"root_winning\":" + std::string(support.complete &&
+            result.start_state < n && support.winning[result.start_state] ? "true" : "false") +
+        ",\"incumbent_present\":" + std::string(output_incumbent.has_value() ? "true" : "false") +
+        ",\"work\":" + std::to_string(support.work) +
+        ",\"passes\":" + std::to_string(support.passes) +
+        ",\"scratch_reserved\":" + std::to_string(scratch) +
+        ",\"expanded\":" + std::to_string(expanded_count) + ",\"coverage\":[";
+    std::vector<std::uint32_t> samples{result.start_state};
+    const auto add_sample = [&](std::uint32_t s) {
+        if (s < n && samples.size() < 6 &&
+            std::find(samples.begin(), samples.end(), s) == samples.end())
+            samples.push_back(s);
+    };
+    // Normal missing continuation, then a few real partial row owners.
+    for (std::uint32_t s = 0; s < n; ++s)
+        if (!terminals[s] && calc.state(s).rarity == PC_RARITY_NORMAL &&
+            select_joint_policy_seed_row(s, result.values) ==
+                std::numeric_limits<std::uint64_t>::max()) { add_sample(s); break; }
+    for (const auto& row : transition_cache->rows)
+        if (satisfied_goal_mask_for_state(row.owner_state) != 0) add_sample(row.owner_state);
+    bool first_state = true;
+    for (const auto s : samples) {
+        if (!first_state) json += ',';
+        first_state = false;
+        json += "{\"state\":" + std::to_string(s) +
+            ",\"goal_mask\":" + std::to_string(satisfied_goal_mask_for_state(s)) +
+            ",\"rarity\":" + std::to_string(calc.state(s).rarity) +
+            ",\"expanded\":" + std::string(s < expanded.size() && expanded[s] ? "true" : "false") +
+            ",\"winning\":" + std::string(support.complete && support.winning[s] ? "true" : "false") +
+            ",\"operators\":[";
+        bool first_op = true;
+        for (std::uint32_t op = 0; op < calc.operators().size(); ++op) {
+            const auto& planner = calc.operators()[op];
+            if (planner.kind != PlannerOperatorKind::Primitive) continue;
+            const auto entry = action_envelope_ledger.find(s, op);
+            const bool requested = std::find(static_operator_indices.begin(), static_operator_indices.end(), op) != static_operator_indices.end() ||
+                std::find(delayed_operator_indices.begin(), delayed_operator_indices.end(), op) != delayed_operator_indices.end();
+            if (!requested && entry == nullptr) continue;
+            if (!first_op) json += ',';
+            first_op = false;
+            json += "{\"index\":" + std::to_string(op) + ",\"id\":";
+            append_json_string(json, planner.id);
+            json += ",\"requested\":" + std::string(requested ? "true" : "false") +
+                ",\"legal\":" + std::string(action_legal(session,
+                    calc.registry().actions.at(planner.primitive_action), calc.state(s)) ? "true" : "false") +
+                ",\"ledger_state\":" + (entry ? std::to_string(static_cast<int>(entry->lifecycle)) : "null") +
+                ",\"lane\":" + (entry ? std::to_string(static_cast<int>(entry->lane)) : "null") +
+                ",\"stop_owner\":" + (entry ? std::to_string(static_cast<int>(entry->stop_owner)) : "null") +
+                ",\"reason\":";
+            append_json_string(json, entry ? entry->detail : "no_ledger_entry");
+            std::uint64_t rows = 0, missing = 0;
+            bool selected = false;
+            if (s < transition_cache->state_rows.size())
+                for (const auto r : state_row_indices(*transition_cache, s)) {
+                    if (r >= priced_rows.size() || priced_rows[r].operator_index != op || !completed[r]) continue;
+                    ++rows;
+                    selected |= s < policy_rows.size() && policy_rows[s] == r;
+                    const auto& row = transition_cache->rows[r];
+                    for (std::uint32_t i = 0; i < row.transition_count; ++i) {
+                        const auto offset = row.transition_offset + i;
+                        const auto t = transition_cache->successors[offset];
+                        if (transition_cache->probabilities[offset] > 0 &&
+                            (t >= n || (!terminals[t] && (t >= transition_cache->state_rows.size() ||
+                                transition_cache->state_rows[t].count == 0)))) ++missing;
+                    }
+                }
+            json += ",\"completed_rows\":" + std::to_string(rows) +
+                ",\"direct_missing_rows\":" + std::to_string(missing) +
+                ",\"selected\":" + std::string(selected ? "true" : "false") + "}";
+        }
+        json += "]}";
+    }
+    json += "]}";
+    if (completed_policy_support_diagnostic.empty()) {
+        completed_policy_support_diagnostic = "[" + json + "]";
+    } else {
+        completed_policy_support_diagnostic.pop_back();
+        completed_policy_support_diagnostic += "," + json + "]";
+    }
+    completed_policy_support_row_generation = transition_cache->rows.size();
+    ++completed_policy_support_observations;
+    carrier_ladder_exact_boundary_private_wall_ns +=
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - started).count();
+}
