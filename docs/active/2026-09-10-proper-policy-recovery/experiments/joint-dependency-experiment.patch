 namespace poecraft {
 namespace solver {
 namespace solve_detail {
+
+SparseProperPolicySupport construct_sparse_proper_policy_support(
+        const SolveTransitionCache& graph,
+        const std::vector<PricedSparseRow>& priced,
+        const std::vector<std::uint8_t>& completed,
+        const std::vector<std::uint8_t>& terminals,
+        const std::uint64_t max_work) {
+    SparseProperPolicySupport out;
+    const auto no_row = std::numeric_limits<std::uint64_t>::max();
+    out.winning.assign(terminals.size(), 1);
+    out.rank.resize(terminals.size(), kNoId);
+    out.rows.resize(terminals.size(), no_row);
+    out.choices.resize(graph.choices.size(), kNoId);
+    const auto visit = [&] { return out.work++ < max_work; };
+    for (;;) {
+        ++out.passes;
+        std::fill(out.rank.begin(), out.rank.end(), kNoId);
+        std::fill(out.rows.begin(), out.rows.end(), no_row);
+        std::fill(out.choices.begin(), out.choices.end(), kNoId);
+        for (std::size_t s = 0; s < terminals.size(); ++s) {
+            if (!visit()) return out;
+            if (terminals[s] && out.winning[s]) out.rank[s] = 0;
+        }
+        bool grew = true;
+        std::uint32_t next_rank = 1;
+        while (grew) {
+            grew = false;
+            for (std::uint32_t s = 0; s < terminals.size(); ++s) {
+                if (!visit()) return out;
+                if (!out.winning[s] || out.rank[s] != kNoId ||
+                    s >= graph.state_rows.size()) continue;
+                for (const auto r : state_row_indices(graph, s)) {
+                    if (!visit()) return out;
+                    if (r >= completed.size() || !completed[r] ||
+                        r >= priced.size() ||
+                        priced[r].operator_index == kNoId ||
+                        !std::isfinite(priced[r].cost) || priced[r].cost < 0)
+                        continue;
+                    const auto& row = graph.rows.at(r);
+                    if (row.owner_state != s) continue;
+                    bool safe = true, progress = false;
+                    for (std::uint32_t i = 0; i < row.transition_count; ++i) {
+                        if (!visit()) return out;
+                        const auto offset = row.transition_offset + i;
+                        if (!(graph.probabilities.at(offset) > 0)) continue;
+                        const auto t = graph.successors.at(offset);
+                        if (t >= out.winning.size() || !out.winning[t]) {
+                            safe = false;
+                            break;
+                        }
+                        progress |= out.rank[t] != kNoId;
+                    }
+                    for (std::uint32_t i = 0; safe && i < row.choice_count; ++i) {
+                        if (!visit()) return out;
+                        const auto ci = row.choice_offset + i;
+                        const auto& group = graph.choices.at(ci);
+                        if (!(group.probability > 0)) continue;
+                        std::uint32_t selected = group.has_self ? s : kNoId;
+                        for (std::uint32_t j = 0; j < group.successor_count; ++j) {
+                            if (!visit()) return out;
+                            const auto t = graph.choice_successors.at(
+                                group.successor_offset + j);
+                            if (t >= out.winning.size() || !out.winning[t]) continue;
+                            if (selected == kNoId ||
+                                std::pair{out.rank[t], t} <
+                                    std::pair{out.rank[selected], selected}) {
+                                selected = t;
+                            }
+                        }
+                        safe = selected != kNoId;
+                        if (safe) progress |= out.rank[selected] != kNoId;
+                        out.choices[ci] = selected;
+                    }
+                    if (!safe || !progress) continue;
+                    out.rank[s] = next_rank++;
+                    out.rows[s] = r;
+                    grew = true;
+                    break;
+                }
+            }
+        }
+        bool removed = false;
+        for (std::size_t s = 0; s < out.winning.size(); ++s) {
+            if (!visit()) return out;
+            if (out.winning[s] && out.rank[s] == kNoId) {
+                out.winning[s] = 0;
+                removed = true;
+            }
+        }
+        if (!removed) {
+            out.complete = true;
+            return out;
+        }
+    }
+}
